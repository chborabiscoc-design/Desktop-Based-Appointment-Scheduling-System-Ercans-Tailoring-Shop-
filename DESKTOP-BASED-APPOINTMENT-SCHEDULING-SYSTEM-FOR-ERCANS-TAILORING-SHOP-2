.m-pdf-comment-panel-list { width: 100%; height: 211px; background: rgb(255, 255, 255); padding: 12px 16px; overflow-y: scroll; }

.m-pdf-comment-panel-list.horizontal-screen { height: 111px; }

.pdf-component-comment-item { padding: 12px 0px; }

.pdf-component-comment-item:first-child { padding-top: 0px; }

.pdf-component-comment-item:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; padding-bottom: 0px; }

.pdf-component-comment-item:only-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; padding-bottom: 16px; }

.pdf-component-comment-item.less-mode { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.pdf-component-comment-item .item-title { display: flex; align-items: center; color: rgba(0, 0, 0, 0.4); }

.pdf-component-comment-item .item-title > span { font-size: 13px; }

.pdf-component-comment-item .item-title .name { line-height: normal; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; margin-right: 8px; margin-left: 12px; }

.pdf-component-comment-item .item-title .time { color: rgba(0, 0, 0, 0.2); white-space: nowrap; }

.pdf-component-comment-item .item-content { font-size: 14px; padding-left: 36px; white-space: pre-wrap; line-height: normal; }

.pdf-component-comment-item .item-content.hasEmptyContent { min-height: 19px; }

.pdf-component-comment-item .item-content .voice-bubble-placeholder { height: 46px; }

.pdf-component-comment-item .item-content .comment-unable-view { color: rgba(8, 14, 23, 0.46); justify-content: space-between; display: flex; align-items: center; padding: 5px 8px; height: 36px; background: rgb(245, 247, 250); border-radius: 6px; }

.pdf-component-comment-item .item-content .comment-unable-view .feedback-btn { color: rgb(10, 108, 255); padding: 0px 8px; }

.card-voice { display: flex; align-items: center; margin-top: 14px; }

.card-voice .voice-play-bar { display: flex; align-items: center; min-width: 66px; max-width: 186px; height: 32px; border-radius: 6px; border: 0.5px solid rgba(0, 0, 0, 0.4); padding: 4px 0px 4px 8px; margin-right: 8px; font-size: 13px; font-weight: 400; color: rgb(0, 0, 0); line-height: 18px; }

.card-voice .voice-play-bar .voice-status { width: 24px; height: 24px; margin-right: 5px; background-image: url("../../../../../images/voice_play_status.458e79bc.svg"); background-size: 96px 24px; background-repeat: no-repeat; background-position: -72px 0px; animation-duration: 1s; animation-timing-function: step-start; animation-iteration-count: infinite; }

.card-voice .voice-loading { width: 20px; height: 20px; background-image: url("../../../../../images/voice_comment_loading.5f338124.svg"); background-size: 100% 100%; animation: 0.75s linear 0s infinite normal none running voiceCommentRotate; }

.voice-translation { display: flex; align-items: center; }

.voice-translation .translation-text { display: flex; justify-content: center; align-items: center; min-width: 37px; min-height: 32px; background: rgb(243, 243, 243); border-radius: 4px; font-size: 13px; font-weight: 400; color: rgb(0, 0, 0); line-height: 18px; margin-top: 3px; margin-right: 3px; padding: 7px 8px; word-break: break-word; }

.voice-translation .translation-text .text-omit { width: 100%; display: flex; justify-content: space-between; align-items: center; }

.voice-translation .translation-text .text-omit span { width: 3px; height: 3px; background: rgb(169, 169, 169); border-radius: 50%; }

@keyframes voiceCommentRotate { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes playStatus { 
  25% { background-position: 0px 0px; }
  50% { background-position: -24px 0px; }
  75% { background-position: -48px 0px; }
  100% { background-position: -72px 0px; }
}

.component-avatar { flex-shrink: 0; position: relative; display: inline-block; height: 24px; width: 24px; border-radius: 50%; overflow: hidden; }

.component-avatar .avatar-img { position: absolute; height: 100%; width: 100%; overflow: hidden; border-radius: 50%; }

.component-avatar .avatar-img .avatar-content { position: absolute; width: 100%; height: 100%; pointer-events: none; }

.component-avatar .avatar-img .icons { width: 100%; height: 100%; }

.component-avatar::after, .component-avatar::before { content: ""; position: absolute; background: rgb(255, 255, 255); z-index: 1; }

.component-avatar::before { width: 1px; height: 100%; left: 50%; top: 0px; transform: translateX(-50%); }

.component-avatar::after { height: 1px; width: 100%; left: 0px; top: 50%; transform: translateY(-50%); }

.component-avatar.avatar-length-1 .avatar-img { position: relative; }

.component-avatar.avatar-length-1 .avatar-content { left: 0px; top: 0px; }

.component-avatar.avatar-length-1::after, .component-avatar.avatar-length-1::before, .component-avatar.avatar-length-2::after { display: none; }

.component-avatar.avatar-length-2 > :first-child { left: -50%; }

.component-avatar.avatar-length-2 > :first-child .avatar-content { top: 0px; right: -25%; }

.component-avatar.avatar-length-2 > :nth-child(2) { left: 50%; }

.component-avatar.avatar-length-2 > :nth-child(2) .avatar-content { top: 0px; left: -25%; }

.component-avatar.avatar-length-3::before { top: 0px; bottom: 0px; }

.component-avatar.avatar-length-3::after { left: 50%; right: 0px; }

.component-avatar.avatar-length-3 > :first-child .avatar-content { left: -25%; }

.component-avatar.avatar-length-3 > :nth-child(2) { left: 50%; top: -50%; }

.component-avatar.avatar-length-3 > :nth-child(2) .avatar-content { left: -25%; bottom: -25%; }

.component-avatar.avatar-length-3 > :nth-child(3) { left: 50%; top: 50%; }

.component-avatar.avatar-length-3 > :nth-child(3) .avatar-content { left: -25%; top: -25%; }

.component-avatar.avatar-length-4::before { top: 0px; bottom: 0px; }

.component-avatar.avatar-length-4::after { left: 0px; right: 0px; }

.component-avatar.avatar-length-4 > :first-child { left: -50%; top: -50%; }

.component-avatar.avatar-length-4 > :first-child .avatar-content { right: -25%; bottom: -25%; }

.component-avatar.avatar-length-4 > :nth-child(2) { left: -50%; top: 50%; }

.component-avatar.avatar-length-4 > :nth-child(2) .avatar-content { right: -25%; top: -25%; }

.component-avatar.avatar-length-4 > :nth-child(3) { left: 50%; top: -50%; }

.component-avatar.avatar-length-4 > :nth-child(3) .avatar-content { left: -25%; bottom: -25%; }

.component-avatar.avatar-length-4 > :nth-child(4) { left: 50%; top: 50%; }

.component-avatar.avatar-length-4 > :nth-child(4) .avatar-content { left: -25%; top: -25%; }

.component-avatar-info { display: flex; flex-direction: column; align-items: center; }

.component-avatar-info .component-avatar { margin-top: 44px; width: 60px; height: 60px; margin-bottom: 12px; }

.component-avatar-info .name { color: var(--kd-color-text-primary); height: 22px; font-size: 14px; line-height: 22px; max-width: 90%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.component-avatar-info .address { height: 20px; line-height: 20px; font-size: 12px; color: var(--kd-color-text-secondary); margin-bottom: 50px; max-width: 70%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.component-avatar-info { display: flex; flex-direction: column; align-items: center; }

.component-avatar-info .component-avatar { margin-top: 44px; width: 60px; height: 60px; margin-bottom: 12px; }

.component-avatar-info .name { color: var(--kd-color-text-primary); height: 22px; font-size: 14px; line-height: 22px; max-width: 90%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

